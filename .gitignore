# --- Match data: NEVER COMMITTED ---------------------------------------------
# The bundle is licensed for this competition only. Distributing it violates
# the ToU.
data/
src/tactical/
*.mp4
*.crdownload

# --- Output: reproducible, so no need to commit ------------------------------
# What is promised is not that the file sits in the repo, but that the repo CAN
# produce that exact file. The official repo also ignores its result CSVs.
#
# ALL .csv files are ignored, not just results/ -- this is a ToU safeguard. If
# you really need to commit a small, safe CSV (e.g. a reference table with no
# match data in it), force it with:  git add -f name.csv
# and write the reason in docs/decisions.md.
results/
*.csv

# --- Official repo, fetched again by tools/fetch_official.py -----------------
# Pinned to a specific commit, so there is no need to store it.
third_party/

# --- Local notes -------------------------------------------------------------
local/
notes/
*.log

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Jupyter -----------------------------------------------------------------
# Notebooks are NOT committed once they have been run: their output can contain
# match data, and this repo will be pushed.
*.ipynb

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
